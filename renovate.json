{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/kubernetes/.+/application\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Group all infrastructure updates",
      "matchFileNames": ["kubernetes/infrastructure/**"],
      "groupName": "infrastructure",
      "automerge": false
    },
    {
      "description": "Group all app updates",
      "matchFileNames": ["kubernetes/apps/**"],
      "groupName": "apps",
      "automerge": false
    }
  ]
}
