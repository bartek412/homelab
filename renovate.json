{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/(^|/)kubernetes/.+/application\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)kubernetes/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values.*\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track argocd-vault-plugin binary version in ArgoCD values",
      "managerFilePatterns": [
        "/(^|/)kubernetes/infrastructure/argocd/values\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>argoproj-labs/argocd-vault-plugin)/releases/download/v(?<currentValue>[^/]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group all infrastructure updates",
      "matchFileNames": [
        "kubernetes/infrastructure/**"
      ],
      "groupName": "infrastructure",
      "automerge": false
    },
    {
      "description": "Group all app updates",
      "matchFileNames": [
        "kubernetes/apps/**"
      ],
      "groupName": "apps",
      "automerge": false
    },
    {
      "description": "Pin wildcard/range Helm charts in ArgoCD applications",
      "matchManagers": [
        "argocd"
      ],
      "rangeStrategy": "pin"
    }
  ]
}
