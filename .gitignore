# ----------------------------------------------------------------------
# Kubernetes / Talos Generated Files
# ----------------------------------------------------------------------
# Talos Admin Configuration (Root access to the OS)
talosconfig
talosconfig*

# Generated Machine Configs (contain certs and keys)
controlplane.yaml
worker.yaml
*.yaml.old

# Kubernetes Admin Configuration (Cluster Admin Access)
kubeconfig
kubeconfig*
config

# Cluster API generated kubeconfigs
/tmp/*-kubeconfig

# ----------------------------------------------------------------------
# Bootstrap Secrets
# ----------------------------------------------------------------------
# Environment files with secrets
.env
*.env
bootstrap/secrets.env

# ----------------------------------------------------------------------
# OS & IDE System Files
# ----------------------------------------------------------------------
# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code
.vscode/

# IntelliJ / JetBrains
.idea/
*.iml

# ----------------------------------------------------------------------
# Miscellaneous
# ----------------------------------------------------------------------
# ISO files (too large for git)
*.iso
*.img

# SSH Keys (if generated locally)
.ssh/
id_rsa
id_rsa.pub

# Local notes and backups
*.bak
*.tmp
TODO.md
notes.txt
